{
  "name": "engineering-bridge",
  "version": "1.4.2-biaogu.15",
  "description": "A local MCP bridge for thin official Codex tasks and safe project binding.",
  "type": "module",
  "files": [
    "dist/src/**",
    "config/workspaces.example.json",
    "docs/**",
    "README.md",
    "README.zh-CN.md",
    "RELEASE_NOTES.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "bin": {
    "engineering-bridge": "dist/src/mcp-stdio.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && node --test \"dist/tests/unit/**/*.test.js\" && node --test tests/siwc/siwc-runtime.test.mjs",
    "siwc:login": "node ops/siwc/siwc-cli.mjs login",
    "siwc:status": "node ops/siwc/siwc-cli.mjs status",
    "siwc:refresh": "node ops/siwc/siwc-cli.mjs refresh",
    "siwc:bridge": "node ops/siwc/start-bridge-siwc.mjs",
    "siwc:smoke": "node ops/siwc/siwc-live-smoke.mjs",
    "mcp:stdio": "node dist/src/mcp-stdio.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "codex",
    "local-first",
    "read-only"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  }
}
